{
  "spec": {
    "display": {
      "name": "Operation",
      "description": "Taxas de INSERT, UPDATE, DELETE e HOT update por tabela do PostgreSQL monitorado."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "table.name",
            "description": "Tabelas PostgreSQL"
          },
          "defaultValue": [],
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "postgresql.table.name",
              "signal": "metrics"
            }
          },
          "name": "table.name"
        }
      }
    ],
    "panels": {
      "0f0ebcbe-4dc8-4d4a-9a5f-0d4a7eb74109": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Inserts por tabela",
            "description": "Taxa de operações INSERT por tabela."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": { "timePreference": "global_time", "fillSpans": false },
              "formatting": { "unit": "none", "decimalPrecision": "2" },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": { "fillOnlyBelow": false, "fillLessThan": "" }
              },
              "axes": { "softMin": 0, "softMax": null, "isLogScale": false },
              "legend": { "position": "bottom", "mode": "list", "customColors": null },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [{ "metricName": "postgresql.operations", "temporality": "", "timeAggregation": "increase", "spaceAggregation": "sum", "reduceTo": "sum" }],
                    "disabled": false,
                    "filter": { "expression": "operation = 'ins' AND postgresql.table.name IN $table.name" },
                    "groupBy": [{ "name": "postgresql.table.name", "signal": "", "fieldContext": "resource", "fieldDataType": "string" }],
                    "order": [],
                    "having": { "expression": "" },
                    "legend": "{{postgresql.table.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
